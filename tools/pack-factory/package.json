{
  "name": "@cg/pack-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Internal Brand Pack Factory: external Brand Kit + master .cgproj files to verified customer .vcg deliveries and visual QC.",
  "type": "module",
  "bin": {
    "cg-pack-factory": "./bin/cg-pack-factory.mjs"
  },
  "files": [
    "dist",
    "bin",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && tsc --noEmit -p tsconfig.studio.json && vite build",
    "clean": "rimraf --glob dist coverage playwright-report test-results *.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json --tsBuildInfoFile typecheck.tsbuildinfo && tsc --noEmit -p tsconfig.studio.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "start": "node ./bin/cg-pack-factory.mjs",
    "studio": "node ./bin/cg-pack-factory.mjs studio"
  },
  "dependencies": {
    "@cg/shared-schema": "workspace:*",
    "@cg/single-file-export": "workspace:*",
    "@cg/vcg-format": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cg/eslint-config": "workspace:*",
    "@playwright/test": "1.60.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
