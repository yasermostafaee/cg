{
  "name": "@cg/skew-harness",
  "version": "0.0.0",
  "private": true,
  "description": "B-174 / B-155 — measures the PAGE/MIXER skew `k` in CHANNEL FRAMES against a real CasparCG, by recording the channel to a file through a second consumer and detecting the two transitions by pixel comparison. Measurement only: it implements no fix and changes no product behaviour.",
  "type": "module",
  "bin": {
    "cg-skew": "./bin/cg-skew.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf --glob dist coverage *.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json --tsBuildInfoFile typecheck.tsbuildinfo",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "start": "node ./bin/cg-skew.mjs"
  },
  "dependencies": {
    "@cg/caspar-bridge": "workspace:*",
    "@cg/shared-ipc": "workspace:*",
    "@cg/shared-schema": "workspace:*",
    "@cg/template-runtime": "workspace:*",
    "@cg/vcg-format": "workspace:*"
  },
  "devDependencies": {
    "@cg/eslint-config": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
