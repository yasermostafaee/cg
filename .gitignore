# Temp files
tmp/
# P-018 — `tmp/` above is a DIRECTORY pattern and cannot match a `tmp-` FILENAME,
# which is how a stray 26MB `apps/designer/tmp-282-long.avi` got committed. Scoped
# to `apps/**` so it cannot swallow legitimate fixtures elsewhere.
apps/**/tmp-*

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
out/
/release/
*.tsbuildinfo

# Electron
.electron/
electron-builder.env

# Turbo
.turbo/

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
# P-009 — `.claude/*` (not `.claude/`) so the two SHARED entries below can be
# re-included: git cannot re-include a file whose parent DIRECTORY is excluded.
# Everything else in .claude/ stays ignored — settings.local.json (personal) and
# the generated OpenSpec slash commands (regenerate: `pnpm openspec init --tools claude`).
.claude/*
!.claude/settings.json
!.claude/hooks/
# The `/ship` slash command is SHARED tooling, so it is tracked. Same re-inclusion
# problem as above, one level deeper: re-include the `commands/` DIRECTORY, then
# re-exclude its contents, then except the single file. This keeps the GENERATED
# OpenSpec slash commands ignored — only `ship.md` is tracked.
!.claude/commands/
.claude/commands/*
!.claude/commands/ship.md
.gate-logs/
.DS_Store
Thumbs.db
desktop.ini

