# Temp files
tmp/
# P-018 — `tmp/` above is a DIRECTORY pattern and cannot match a `tmp-` FILENAME,
# which is how a stray 26MB `apps/designer/tmp-282-long.avi` got committed. Scoped
# to `apps/**` so it cannot swallow legitimate fixtures elsewhere.
apps/**/tmp-*

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
out/
/release/
*.tsbuildinfo

# Electron
.electron/
electron-builder.env

# Turbo
.turbo/

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
# P-009 — `.claude/*` (not `.claude/`) so the two SHARED entries below can be
# re-included: git cannot re-include a file whose parent DIRECTORY is excluded.
# Everything else in .claude/ stays ignored — settings.local.json (personal) and
# the generated OpenSpec slash commands (regenerate: `pnpm openspec init --tools claude`).
.claude/*
!.claude/settings.json
!.claude/hooks/
# P-035 — the never-stage list. It MUST be tracked: an untracked list is a guard
# that silently does nothing on any other checkout, which is the failure mode the
# guard itself exists to prevent.
!.claude/never-stage
# No slash command is tracked any more: `/ship` automated the retired per-change
# branch + PR ship sequence and was deleted with that model (see `P-026`). The
# GENERATED OpenSpec slash commands stay ignored, so `.claude/commands/` needs no
# re-inclusion at all. If a SHARED command is ever added back, restore the
# three-line dance: re-include the directory, re-exclude its contents, then
# except the single tracked file.
.gate-logs/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
!.env.example

# Local SQLite / app data
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Generated fixtures (re-buildable from sources)
fixtures/templates/*/template.vcg

# Signing artifacts
*.p12
*.pfx
*.snk
keys/

# Playwright E2E (P-005)
playwright-report/
test-results/
blob-report/
.playwright/

