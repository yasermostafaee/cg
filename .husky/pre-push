# Local pre-merge gate while GitHub Actions minutes are exhausted (see README
# "Local gate"). Runs the FAST full gate before every push and blocks the push if it
# fails. E2E is NOT here (too slow, ~6 min) — run it manually with `pnpm gate:e2e` for
# any UI/layout/rendering change. Emergency bypass: `git push --no-verify`.
#
# P-010: git feeds this hook one `<local ref> <local oid> <remote ref> <remote oid>`
# line per ref on stdin. A ref DELETION pushes no content, so gating it proves nothing
# (the gate inspects the WORKING TREE) while consuming this host's one exclusive gate
# slot for ~2 minutes. Skip the gate only when EVERY ref is a deletion. This narrows
# WHEN the gate runs, never WHAT it checks: a mixed push, an unparseable line, empty
# stdin, or a missing/failing node all fall through to the full gate.
decision=$(node tools/gate-hook/src/pre-push-cli.mjs 2>/dev/null) || decision=gate

if [ "$decision" = "skip" ]; then
  echo "pre-push: gate SKIPPED — every ref in this push is a DELETION, so there is no pushed content for it to check (P-010). Any push carrying a real ref update runs the full gate."
  exit 0
fi

# P-013: `pnpm gate` now acquires this host's exclusive gate slot (a host-wide advisory
# lock inside the `gate` script). So if this push fires while a Stop-hook gate — or a
# gate in another worktree — is already running, THIS one WAITS for the slot instead of
# racing it over vitest's shared coverage tmp dir (the false-ENOENT double-fire, B-097).
pnpm gate
